# Zieladresse für Kontaktanfragen
CONTACT_TO=tillscheidegget@gmail.com

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Gmail-Adresse, über die deine Webseite die Nachrichten verschickt
SMTP_USER=tillscheidegget@gmail.com

# HIER EIN GOOGLE APP-PASSWORT EINTRAGEN - NICHT dein normales Gmail-Passwort
SMTP_PASS=DEIN_GOOGLE_APP_PASSWORT

# Optional; normalerweise gleich wie SMTP_USER
SMTP_FROM=tillscheidegget@gmail.com

PORT=3000

# Admin Login
ADMIN_USER=admin
ADMIN_PASSWORD=DEIN_SICHERES_ADMIN_PASSWORT

# Muss lang und zufällig sein
SESSION_SECRET=HIER_EINEN_LANGEN_ZUFAELLIGEN_SECRET_EINTRAGEN

# Bei HTTPS Hosting auf true setzen
COOKIE_SECURE=false
