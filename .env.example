# Lokale Entwicklungs-Konfiguration
CONTACT_TO=deine-email@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deine-gmail-adresse@gmail.com
SMTP_PASS=DEIN_GOOGLE_APP_PASSWORT
SMTP_FROM=deine-gmail-adresse@gmail.com

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

ADMIN_USER=admin
ADMIN_PASSWORD=DEIN_SICHERES_ADMIN_PASSWORT
SESSION_SECRET=EIN_LANGER_ZUFAELLIGER_SECRET

# Zahlungen standardmässig AUS lassen.
PAYMENT_ENABLED=false
STRIPE_SECRET_KEY=DEIN_STRIPE_SECRET_KEY
PUBLIC_BASE_URL=http://localhost:3000
