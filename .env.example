# Lokale Entwicklungs-Konfiguration
CONTACT_TO=deine-email@example.com

# Empfohlen für Render Free: Kontakt über HTTPS-Mail-API
RESEND_API_KEY=DEIN_RESEND_API_KEY
RESEND_FROM=Till Website <onboarding@resend.dev>

# Optionaler SMTP-Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deine-gmail-adresse@gmail.com
SMTP_PASS=DEIN_GOOGLE_APP_PASSWORT
SMTP_FROM=deine-gmail-adresse@gmail.com

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

ADMIN_USER=admin
ADMIN_PASSWORD=DEIN_SICHERES_ADMIN_PASSWORT
SESSION_SECRET=EIN_LANGER_ZUFAELLIGER_SECRET

# Stripe Checkout
PAYMENT_ENABLED=true
STRIPE_SECRET_KEY=sk_test_DEIN_STRIPE_TEST_KEY
PUBLIC_BASE_URL=http://localhost:3000
